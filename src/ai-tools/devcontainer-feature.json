{
    "id": "ai-tools",
    "version": "1.1.0",
    "name": "AI Development Tools",
    "description": "Claude Code with a shared login and shared configuration across containers, plus optional OpenCode.",
    "documentationURL": "https://github.com/lucassoumaille/devcontainer-features/tree/main/src/ai-tools",
    "licenseURL": "https://github.com/lucassoumaille/devcontainer-features/blob/main/LICENSE",
    "options": {
        "installOpenCode": {
            "type": "boolean",
            "default": true,
            "description": "Install the OpenCode CLI (opencode-ai) with npm."
        }
    },
    "dependsOn": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/node"
    ],
    "mounts": [
        {
            "source": "claude-code-config",
            "target": "/mnt/claude-config",
            "type": "volume"
        }
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/mnt/claude-config"
    },
    "postStartCommand": "/usr/local/share/ai-tools/sync-claude-config.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code"
            ]
        }
    }
}
